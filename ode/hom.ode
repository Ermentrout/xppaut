# hom.ode -- a homoclinic orbit of  x''=x(1-x)-a x'+sig x x'  followed in the two parameters (a,sig).
# Needs only the model.  Run  hom.xps  (File -> Do script) or follow the AUTO chapter of the manual:
#   integrate onto the stable cycle, Initialconds Periodic, then AUTO: Run -> Homoclinic.
x'=y
y'=x*(1-x)-a*y+sig*x*y
par a=0.05,sig=0.05833
init x=0.5,y=0
@ total=4000,dt=0.01,meth=8,xp=x,yp=y
@ xlo=-0.5,xhi=1.7,ylo=-0.8,yhi=0.8
@ autoxmin=0,autoxmax=0.3,autoymin=0,autoymax=0.4,parmin=0,parmax=0.3
done
